# 复制为 /etc/bianbu/webui.env，并由 root 设置为 0640 root:bianbu-security。
# 生产必须使用高熵随机 token；不要把真实 token 提交到仓库。
BIANBU_WEBUI_AUTH=0
# 仅当 BIANBU_WEBUI_AUTH=1 时需要配置：
# BIANBU_WEBUI_TOKEN=REPLACE_WITH_至少32字节随机值
# 本机浏览器自动换取 HttpOnly 会话；远程访问仍需手动输入 token。
BIANBU_WEBUI_LOCAL_AUTO_AUTH=1
# 持久会话签名密钥；至少 32 字节，必须与 token 不同。
BIANBU_WEBUI_SECRET=REPLACE_WITH_DIFFERENT_至少32字节随机值
# 可选只读 token，必须与管理员 token 不同。
# BIANBU_WEBUI_VIEWER_TOKEN=REPLACE_WITH_DIFFERENT_RANDOM_VALUE
# 默认只监听回环。非回环监听必须配置 TLS 证书/私钥，或受信 TLS 反代。
BIANBU_WEBUI_HOST=0.0.0.0
BIANBU_WEBUI_PORT=8787
# BIANBU_WEBUI_TLS_CERT=/etc/bianbu/tls/webui.crt
# BIANBU_WEBUI_TLS_KEY=/etc/bianbu/tls/webui.key
# 使用 TLS 反代时：
# BIANBU_WEBUI_TRUST_PROXY=1
# 普通 shell 默认关闭；仅管理员可开，生产建议保持关闭。
BIANBU_WEBUI_ENABLE_SHELL=0
BIANBU_WEBUI_ALLOW_INSECURE_REMOTE=0
