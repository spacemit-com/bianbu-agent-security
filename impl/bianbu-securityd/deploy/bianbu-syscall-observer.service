[Unit]
Description=Bianbu seccomp kernel audit observer
Before=bianbu-securityd.service

[Service]
Type=simple
User=root
ExecStart=/usr/bin/python3 -I /usr/lib/bianbu-securityd/deploy/syscall-kernel-observer.py
RuntimeDirectory=bianbu-syscall-audit
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/run/bianbu-syscall-audit /sys/kernel/tracing
CapabilityBoundingSet=CAP_BPF CAP_PERFMON CAP_SYS_ADMIN CAP_SYS_RESOURCE CAP_SYS_PTRACE CAP_DAC_OVERRIDE
RestrictSUIDSGID=yes
UMask=0022

[Install]
WantedBy=multi-user.target
